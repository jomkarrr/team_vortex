# Backend env template — NEVER put real values in this file, and never commit a real .env.
# Service key lives in Supabase only (SQL Editor / Edge Function secrets).
# Frontend uses only VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY (see frontend/.env.example).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, only when the corresponding Edge Function exists:
# DATA_GOV_IN_API_KEY=
